# The document converter.
#
# Turns an uploaded PowerPoint or Word file into a PDF (LibreOffice, headless) and then one PNG per
# page (Poppler's pdftoppm) — see packages/document-converter/src/convert.ts for why those two
# specific tools, and packages/document-player/README.md for why the player only ever renders images.
#
# Unlike every other service in this repo, the runtime stage needs real system packages, not just
# Node: LibreOffice and Poppler are native binaries this Dockerfile's build stage cannot produce by
# compiling TypeScript, so they are apt-installed straight into the runtime image.
FROM node:20-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json ./
RUN pnpm install --no-frozen-lockfile
COPY packages ./packages
COPY src ./src
RUN pnpm exec tsc -p tsconfig.build.json

FROM node:20-bookworm-slim
ENV NODE_ENV=production
# --no-install-recommends keeps this off the full LibreOffice suite (no Draw, Base, Math, help
# packs); Impress and Writer are the two filters this service actually calls through soffice's
# generic --convert-to pdf, which dispatches to whichever filter matches the input extension.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       libreoffice-impress libreoffice-writer libreoffice-core poppler-utils fonts-dejavu fonts-liberation \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
RUN mkdir -p /app/data && chown node:node /app/data
USER node
EXPOSE 5100
CMD ["node","dist/packages/document-converter/src/server.js"]
