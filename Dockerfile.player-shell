FROM node:20-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml ./
COPY packages/player-shell/package.json ./packages/player-shell/package.json
COPY packages/example-react-xapi-experience/package.json ./packages/example-react-xapi-experience/package.json
COPY packages/quiz-player/package.json ./packages/quiz-player/package.json
COPY packages/video-player/package.json ./packages/video-player/package.json
COPY packages/document-player/package.json ./packages/document-player/package.json
COPY packages/audio-player/package.json ./packages/audio-player/package.json
COPY packages/ebook-player/package.json ./packages/ebook-player/package.json
RUN pnpm install --no-frozen-lockfile
COPY packages/player-shell ./packages/player-shell
COPY packages/contracts ./packages/contracts
COPY packages/example-module ./packages/example-module
COPY packages/example-react-xapi-experience ./packages/example-react-xapi-experience
COPY packages/example-coaching-chatbot ./packages/example-coaching-chatbot
COPY packages/quiz-player ./packages/quiz-player
COPY packages/coach-player ./packages/coach-player
COPY packages/video-player ./packages/video-player
COPY packages/document-player ./packages/document-player
COPY packages/audio-player ./packages/audio-player
COPY packages/ebook-player ./packages/ebook-player
COPY tsconfig.json ./
# Explicit, because Vite hands NODE_ENV straight to React and React treats anything that is not
# "production" as a development build — development-only behaviour shipped to learners, in a
# bundle nearly three times the size. Unset happens to mean production here; inherited does not.
ENV NODE_ENV=production

RUN pnpm --filter player-shell build
RUN pnpm --filter example-react-xapi-experience build
RUN pnpm --filter quiz-player build
RUN pnpm --filter video-player build
RUN pnpm --filter document-player build
RUN pnpm --filter audio-player build
RUN pnpm --filter ebook-player build
FROM nginx:1.27-alpine
RUN printf 'server { listen 8080; root /usr/share/nginx/html; add_header Access-Control-Allow-Origin "*" always; location = /health { default_type application/json; return 200 "{\"status\":\"ok\"}"; } location = /index.html { add_header Access-Control-Allow-Origin "*" always; add_header Cache-Control "no-store"; } location / { try_files $uri $uri/ /index.html; } }' >/etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/player-shell/dist /usr/share/nginx/html
COPY --from=build /app/packages/player-shell/lti-launch-fallback /usr/share/nginx/html/modules/lti-launch
COPY --from=build /app/packages/player-shell/external-embed-fallback /usr/share/nginx/html/modules/external-embed
COPY --from=build /app/packages/example-module/src /usr/share/nginx/html/module
COPY --from=build /app/packages/example-react-xapi-experience/dist /usr/share/nginx/html/modules/reflective-practice-studio
COPY --from=build /app/packages/example-coaching-chatbot/src /usr/share/nginx/html/modules/career-coach-chat
COPY --from=build /app/packages/quiz-player/dist /usr/share/nginx/html/modules/quiz-player
COPY --from=build /app/packages/coach-player/src /usr/share/nginx/html/modules/coach-player
COPY --from=build /app/packages/video-player/dist /usr/share/nginx/html/modules/video-player
COPY --from=build /app/packages/document-player/dist /usr/share/nginx/html/modules/document-player
COPY --from=build /app/packages/audio-player/dist /usr/share/nginx/html/modules/audio-player
COPY --from=build /app/packages/ebook-player/dist /usr/share/nginx/html/modules/ebook-player
EXPOSE 8080
