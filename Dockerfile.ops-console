FROM node:20-bookworm-slim AS build

RUN corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copy the workspace manifests before installing so pnpm discovers the
# ops-console workspace and installs its React, Vite, and TypeScript packages.
COPY package.json pnpm-workspace.yaml ./
COPY packages/ops-console/package.json ./packages/ops-console/package.json
COPY packages/web-auth/package.json ./packages/web-auth/package.json

RUN pnpm install --no-frozen-lockfile

COPY packages/ops-console ./packages/ops-console
COPY packages/web-auth ./packages/web-auth
# The shared UI design-system foundation that ops-console's styles.css imports by relative path.
COPY packages/design-system ./packages/design-system

# Vite substitutes these public, non-secret values during the image build.
ARG VITE_RUNTIME_API_BASE
ARG VITE_EVIDENCE_API_BASE
ARG VITE_JWKS_URL
ARG VITE_ALLOWED_API_ORIGINS
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_AUDIENCE
ARG VITE_OIDC_SCOPE
ARG VITE_ENVIRONMENT_LABEL
# Optional: route-only link to the separately deployed Administration workspace. Not required to build.
ARG VITE_ADMIN_UI_ORIGIN
# The development sign-in, for a build with no identity provider. Undeclared here it could not
# be set at all: Vite substitutes at build time, so a variable the image never receives leaves
# the bundle holding its localhost default — which is what a deployed front end then tried to
# reach, from the learner's own machine.
ARG VITE_DEVELOPMENT_LOGIN_URL
ARG VITE_DEVELOPMENT_IDENTITY_LOGIN_URL

ENV VITE_RUNTIME_API_BASE=${VITE_RUNTIME_API_BASE}
ENV VITE_EVIDENCE_API_BASE=${VITE_EVIDENCE_API_BASE}
ENV VITE_JWKS_URL=${VITE_JWKS_URL}
ENV VITE_ALLOWED_API_ORIGINS=${VITE_ALLOWED_API_ORIGINS}
ENV VITE_OIDC_ISSUER=${VITE_OIDC_ISSUER}
ENV VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID}
ENV VITE_OIDC_REDIRECT_URI=${VITE_OIDC_REDIRECT_URI}
ENV VITE_OIDC_AUDIENCE=${VITE_OIDC_AUDIENCE}
ENV VITE_OIDC_SCOPE=${VITE_OIDC_SCOPE}
ENV VITE_ENVIRONMENT_LABEL=${VITE_ENVIRONMENT_LABEL}
ENV VITE_ADMIN_UI_ORIGIN=${VITE_ADMIN_UI_ORIGIN}
ENV VITE_DEVELOPMENT_LOGIN_URL=${VITE_DEVELOPMENT_LOGIN_URL}
ENV VITE_DEVELOPMENT_IDENTITY_LOGIN_URL=${VITE_DEVELOPMENT_IDENTITY_LOGIN_URL}

# The environment this image is built for, declared rather than inferred. Outside development it
# must name a real identity provider: there is no fallback sign-in to fall back to.
RUN case "${VITE_ENVIRONMENT_LABEL}" in \
        PRODUCTION|STAGING|DEVELOPMENT) : ;; \
        *) echo "VITE_ENVIRONMENT_LABEL must be PRODUCTION, STAGING or DEVELOPMENT" >&2; exit 1 ;; \
    esac \
    && if [ "${VITE_ENVIRONMENT_LABEL}" != "DEVELOPMENT" ]; then \
           test -n "${VITE_OIDC_ISSUER}" && test -n "${VITE_OIDC_CLIENT_ID}" \
           || { echo "VITE_OIDC_ISSUER and VITE_OIDC_CLIENT_ID are required outside development" >&2; exit 1; }; \
       fi \
    && if [ "${VITE_ENVIRONMENT_LABEL}" != "DEVELOPMENT" ]; then \
           test -z "${VITE_DEVELOPMENT_LOGIN_URL}" && test -z "${VITE_DEVELOPMENT_IDENTITY_LOGIN_URL}" \
           || { echo "the development sign-in must not be built into a non-development image" >&2; exit 1; }; \
       fi

# Explicit, because Vite hands NODE_ENV straight to React and React treats anything that is not
# "production" as a development build — development-only behaviour shipped to learners, in a
# bundle nearly three times the size. Unset happens to mean production here; inherited does not.
ENV NODE_ENV=production

RUN pnpm --filter ops-console build

FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf \
    && printf '%s\n' \
        'server {' \
        '    listen 8080;' \
        '    listen [::]:8080;' \
        '    server_name _;' \
        '' \
        '    root /usr/share/nginx/html;' \
        '    index index.html;' \
        '' \
        '    location = /health {' \
        '        access_log off;' \
        '        default_type application/json;' \
        '        return 200 "{\"status\":\"ok\"}";' \
        '    }' \
        '' \
        '    location / {' \
        '        try_files $uri $uri/ /index.html;' \
        '    }' \
        '}' \
        > /etc/nginx/conf.d/ops-console.conf

COPY --from=build /app/packages/ops-console/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
