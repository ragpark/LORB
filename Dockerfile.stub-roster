FROM node:20-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json ./
# The workspace tsc build below also compiles packages/mcp-connector, so its manifest must be present
# before install for the MCP SDK dependency to resolve.
COPY packages/mcp-connector/package.json ./packages/mcp-connector/package.json
RUN pnpm install --no-frozen-lockfile
COPY packages ./packages
COPY src ./src
RUN pnpm exec tsc -p tsconfig.build.json
FROM node:20-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4100
CMD ["node","dist/packages/stub-roster/src/server.js"]
