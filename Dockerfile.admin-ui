FROM node:20-bookworm-slim AS build

RUN corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Copy the workspace manifests before installing so pnpm discovers the
# admin-ui workspace and installs its React, Vite, and TypeScript packages.
COPY package.json pnpm-workspace.yaml ./
COPY packages/admin-ui/package.json ./packages/admin-ui/package.json
COPY packages/web-auth/package.json ./packages/web-auth/package.json

RUN pnpm install --no-frozen-lockfile

COPY packages/admin-ui ./packages/admin-ui
COPY packages/web-auth ./packages/web-auth
# The shared UI design-system foundation that admin-ui's styles.css imports by relative path.
COPY packages/design-system ./packages/design-system

# Vite substitutes these public, non-secret values during the image build.
ARG VITE_ADMIN_API_BASE
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_AUDIENCE
ARG VITE_OIDC_SCOPE
ARG VITE_ENVIRONMENT_LABEL

ENV VITE_ADMIN_API_BASE=${VITE_ADMIN_API_BASE}
ENV VITE_OIDC_ISSUER=${VITE_OIDC_ISSUER}
ENV VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID}
ENV VITE_OIDC_REDIRECT_URI=${VITE_OIDC_REDIRECT_URI}
ENV VITE_OIDC_AUDIENCE=${VITE_OIDC_AUDIENCE}
ENV VITE_OIDC_SCOPE=${VITE_OIDC_SCOPE}
ENV VITE_ENVIRONMENT_LABEL=${VITE_ENVIRONMENT_LABEL}

# Railway deployment of this image is expressly limited to non-production.
RUN case "${VITE_ENVIRONMENT_LABEL}" in \
        PRODUCTION|STAGING|DEVELOPMENT) : ;; \
        *) echo "VITE_ENVIRONMENT_LABEL must be PRODUCTION, STAGING or DEVELOPMENT" >&2; exit 1 ;; \
    esac \
    && if [ "${VITE_ENVIRONMENT_LABEL}" != "DEVELOPMENT" ]; then \
           test -n "${VITE_OIDC_ISSUER}" && test -n "${VITE_OIDC_CLIENT_ID}" \
           || { echo "VITE_OIDC_ISSUER and VITE_OIDC_CLIENT_ID are required outside development" >&2; exit 1; }; \
       fi

# Explicit, because Vite hands NODE_ENV straight to React and React treats anything that is not
# "production" as a development build — development-only behaviour shipped to learners, in a
# bundle nearly three times the size. Unset happens to mean production here; inherited does not.
ENV NODE_ENV=production

RUN pnpm --filter admin-ui build

FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf \
    && printf '%s\n' \
        'server {' \
        '    listen 8080;' \
        '    listen [::]:8080;' \
        '    server_name _;' \
        '' \
        '    root /usr/share/nginx/html;' \
        '    index index.html;' \
        '' \
        '    location = /health {' \
        '        access_log off;' \
        '        default_type application/json;' \
        '        return 200 "{\"status\":\"ok\"}";' \
        '    }' \
        '' \
        '    location / {' \
        '        try_files $uri $uri/ /index.html;' \
        '    }' \
        '}' \
        > /etc/nginx/conf.d/admin-ui.conf

COPY --from=build /app/packages/admin-ui/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
