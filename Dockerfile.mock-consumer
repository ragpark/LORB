FROM node:20-bookworm-slim AS build

RUN corepack enable \
    && corepack prepare pnpm@9.15.0 --activate

WORKDIR /app

# Install from the workspace root so pnpm resolves the mock package's complete
# build dependency graph before the application source is copied.
COPY package.json pnpm-workspace.yaml ./
COPY packages/mock-consumer/package.json ./packages/mock-consumer/package.json
RUN pnpm install --no-frozen-lockfile

COPY packages/mock-consumer ./packages/mock-consumer
# The shared UI design-system foundation that mock-consumer's styles.css imports by relative path.
COPY packages/design-system ./packages/design-system

# Vite substitutes these public, non-secret integration values at build time.
ARG VITE_RUNTIME_API_BASE
ARG VITE_JWKS_URL
ARG VITE_PLAYER_SHELL_ORIGIN
ARG VITE_STUB_IES_ISSUER
ARG VITE_STUB_IES_LOGIN_URL
ARG VITE_ENVIRONMENT_LABEL
ARG VITE_ALLOWED_SHELL_ORIGINS

ENV VITE_RUNTIME_API_BASE=${VITE_RUNTIME_API_BASE}
ENV VITE_JWKS_URL=${VITE_JWKS_URL}
ENV VITE_PLAYER_SHELL_ORIGIN=${VITE_PLAYER_SHELL_ORIGIN}
ENV VITE_STUB_IES_ISSUER=${VITE_STUB_IES_ISSUER}
ENV VITE_STUB_IES_LOGIN_URL=${VITE_STUB_IES_LOGIN_URL}
ENV VITE_ENVIRONMENT_LABEL=${VITE_ENVIRONMENT_LABEL}
ENV VITE_ALLOWED_SHELL_ORIGINS=${VITE_ALLOWED_SHELL_ORIGINS}

# This image must never be built for a production environment. Require every
# integration endpoint and an explicit, non-wildcard shell origin allow-list.
RUN test "${VITE_ENVIRONMENT_LABEL}" = "RAILWAY-NON-PROD" \
    && test -n "${VITE_RUNTIME_API_BASE}" \
    && test -n "${VITE_JWKS_URL}" \
    && test -n "${VITE_PLAYER_SHELL_ORIGIN}" \
    && test -n "${VITE_STUB_IES_ISSUER}" \
    && test -n "${VITE_STUB_IES_LOGIN_URL}" \
    && test -n "${VITE_ALLOWED_SHELL_ORIGINS}" \
    && test "${VITE_ALLOWED_SHELL_ORIGINS}" != "*"

RUN pnpm --filter mock-consumer build

FROM nginx:1.27-alpine AS runtime

RUN rm /etc/nginx/conf.d/default.conf \
    && printf '%s\n' \
        'server {' \
        '    listen 8080;' \
        '    listen [::]:8080;' \
        '    server_name _;' \
        '' \
        '    root /usr/share/nginx/html;' \
        '    index index.html;' \
        '' \
        '    location = /health {' \
        '        access_log off;' \
        '        default_type application/json;' \
        '        return 200 "{\"status\":\"ok\"}";' \
        '    }' \
        '' \
        '    location / {' \
        '        try_files $uri $uri/ /index.html;' \
        '    }' \
        '}' \
        > /etc/nginx/conf.d/mock-consumer.conf

COPY --from=build /app/packages/mock-consumer/dist /usr/share/nginx/html

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
