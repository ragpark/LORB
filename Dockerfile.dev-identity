# The development identity provider.
#
# It mints a short-lived token for whatever subject it is given, so it stands in for a real provider
# during local work and in nothing else. The Runtime API accepts it only when ALLOW_SYNTHETIC_IDENTITY
# is set, which production configuration refuses outright.
FROM node:20-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json ./
# The workspace tsc build below also compiles packages/mcp-connector, so its manifest must be present
# before install for the MCP SDK dependency to resolve.
COPY packages/mcp-connector/package.json ./packages/mcp-connector/package.json
RUN pnpm install --no-frozen-lockfile
COPY packages ./packages
COPY src ./src
RUN pnpm exec tsc -p tsconfig.build.json
FROM node:20-bookworm-slim
# Development only: this image has no password, no consent and no user directory behind it. The
# platform refuses to trust it when its own NODE_ENV is production.
ENV NODE_ENV=development
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4000
CMD ["node","dist/packages/dev-identity/src/server.js"]
