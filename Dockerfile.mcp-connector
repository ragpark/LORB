FROM node:20-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml tsconfig.json tsconfig.build.json ./
COPY packages/mcp-connector/package.json ./packages/mcp-connector/package.json
RUN pnpm install --no-frozen-lockfile
COPY packages ./packages
COPY src ./src
RUN pnpm exec tsc -p tsconfig.build.json
FROM node:20-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/mcp-connector/node_modules ./packages/mcp-connector/node_modules
COPY --from=build /app/dist ./dist
USER node
EXPOSE 4200
CMD ["node","dist/packages/mcp-connector/src/server.js"]
