# Runtime configuration read by server/index.mjs and served to the SPA at /app-config.json.
# None of these are secrets. Platform-injected variables (APP_SECRET_KEY, SESSION_KEY, OIDC_*) are not read by the app.

# Which storage adapter the UI uses: mock | sharepoint | dataverse
STORAGE_PROVIDER=mock

# Entra ID SPA app registration used by MSAL for Microsoft Graph / Dataverse / Companion gateway tokens
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# SharePoint-first persistence (Option A)
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# Dataverse-first persistence (Option B)
DATAVERSE_ORG_URL=

# SDD Companion gateway (see docs/09-api-layer-design.md). Leave empty to use the built-in mock.
COMPANION_BASE_URL=
COMPANION_SCOPE=

# Port the Node host listens on (Cookie expects 8080)
PORT=8080
