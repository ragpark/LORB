NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://lorb:lorb@localhost:5432/lorb_mvp
DESCRIPTOR_PRIVATE_KEY_PATH=./keys/descriptor-signing-private.pem
DESCRIPTOR_KID=mvp-key-001
PSEUDONYM_TENANT_SECRET=<hex-encoded-32-byte-secret>
STUB_IES_ISSUER=http://localhost:4000
STUB_IES_JWKS_URL=http://localhost:4000/.well-known/jwks.json
STUB_LRS_URL=http://localhost:5000
RUNTIME_API_PORT=3000
# Railway supplies PORT automatically; set it only for other hosting platforms.
# PORT=3000
EVIDENCE_API_PORT=3100
PLAYER_SHELL_PORT=3200
# Optional comma-separated exact origins. When unset, the local consumer and the
# hosted LORB consumer are allowed; setting this value replaces that default list.
ALLOWED_CONSUMER_ORIGINS=http://localhost:3300,https://lorb-production-consumer.up.railway.app
