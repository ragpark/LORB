NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgres://lorb:lorb@localhost:5432/lorb_mvp
DESCRIPTOR_PRIVATE_KEY_PATH=./keys/descriptor-signing-private.pem
DESCRIPTOR_KID=mvp-key-001
PSEUDONYM_TENANT_SECRET=<hex-encoded-32-byte-secret>
STUB_IES_ISSUER=http://localhost:4000
STUB_IES_JWKS_URL=http://localhost:4000/.well-known/jwks.json
STUB_LRS_URL=http://localhost:5000
# Synthetic, non-production class/roster stub (packages/stub-roster). No real people.
STUB_ROSTER_URL=http://localhost:4100
STUB_ROSTER_PORT=4100
RUNTIME_API_PORT=3000
# Railway supplies PORT automatically; set it only for other hosting platforms.
# PORT=3000
EVIDENCE_API_PORT=3100
PLAYER_SHELL_PORT=3200
# Optional comma-separated exact additional origins. The local consumer and the
# hosted LORB consumer are always allowed.
ALLOWED_CONSUMER_ORIGINS=http://localhost:3300,https://lorb-production-consumer.up.railway.app
# Administration workspace (Wave 1). See packages/admin-ui/README.md.
ADMIN_ALLOWED_ROLES=admin
ADMIN_APPROVAL_REQUIRED_FOR=repository.suspend,repository.retire,player_version.approve,player_version.activate,player_version.suspend,launch_policy_version.publish,launch_policy_version.activate

# ---------------------------------------------------------------------------
# MCP agent connector (packages/mcp-connector) — PoC only, not certified.
#
# Two separate trust domains. These credentials must never be the same value as
# each other, and neither may ever appear in a launch descriptor or an IES token.
#   MCP_POC_BEARER_TOKEN           agent-facing (the teacher's agent session)
#   RUNTIME_INTERNAL_SERVICE_TOKEN service-to-service (Runtime internal surface)
# Generate each with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# AUTH_MODE=poc uses the pre-shared token below (local dev and CI only).
# AUTH_MODE=oidc validates tokens from an identity provider you already run; see the
# packages/mcp-connector README. The two are mutually exclusive — in oidc mode the
# pre-shared token must be absent, so it cannot remain a second way in.
AUTH_MODE=poc
MCP_POC_BEARER_TOKEN=<hex-encoded-32-byte-agent-bearer-token>
# AUTH_MODE=oidc only. Example values are Auth0-shaped; see the mcp-connector README.
# The issuer must be copied EXACTLY as the provider's discovery document reports it —
# Auth0's carries a trailing slash and the claim is compared byte for byte.
# OIDC_ISSUER=https://your-tenant.us.auth0.com/
# The audience is your Auth0 API Identifier, and should be the connector's own /mcp URL
# so a client's resource check matches. Never derived — a token minted for another API
# in the same tenant must not open this one.
# OIDC_AUDIENCE=https://your-connector/mcp
# MCP_PUBLIC_URL=https://your-connector
# Derived from OIDC_ISSUER when unset; only needed for a non-standard JWKS location.
# OIDC_JWKS_URL=
# A permission defined on the API. A valid token lacking it gets 403, not access.
# OIDC_REQUIRED_SCOPE=
RUNTIME_INTERNAL_SERVICE_TOKEN=<hex-encoded-32-byte-service-token>
MCP_CONNECTOR_PORT=4200
RUNTIME_API_BASE=http://localhost:3000
# The MVP evidence store is process-local to the Runtime API, so this defaults to RUNTIME_API_BASE.
EVIDENCE_API_BASE=http://localhost:3000
ROSTER_API_BASE=http://localhost:4100
