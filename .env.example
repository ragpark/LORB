# LORB configuration reference.
#
# Copy to .env for local development. Every value below is read once, at start-up, by
# packages/runtime-api/src/config — and a production or staging process refuses to start if any
# setting it needs is missing, so a misconfigured deployment fails loudly rather than running in a
# degraded shape. Run the service with NODE_ENV=production to see exactly what it wants.
#
# Nothing in this file is a real credential. Generate each secret with `openssl rand -hex 32` and
# keep it in a secret store, never in source control.

# --------------------------------------------------------------------------- core
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# The system of record. Required in production and staging: in-memory state is not a system of
# record, and the service refuses to start without this outside development.
DATABASE_URL=postgres://lorb:lorb@localhost:5432/lorb
# Bounded so a burst of launches cannot exhaust the database's connection slots.
DATABASE_POOL_MAX=10
# Set to "no-verify" only where a managed provider terminates TLS with a certificate the container
# cannot chain to, and only deliberately.
# DATABASE_SSL=no-verify

# --------------------------------------------------------------------------- identity
# The public URLs the platform is reached at. Must be https outside development.
RUNTIME_PUBLIC_ISSUER=http://localhost:3000
PLAYER_SHELL_ORIGIN=http://localhost:3200
EVIDENCE_API_ENDPOINT=http://localhost:3000/api/v1/evidence/statements

# The identity provider the platform trusts for learner and administrator access tokens.
#
# The issuer is compared byte for byte against the token's `iss` claim, so copy it exactly as the
# provider's discovery document reports it — several providers include a trailing slash.
OIDC_ISSUER=http://localhost:4000
# Derived from the issuer when unset; set only for a non-standard JWKS location.
# OIDC_JWKS_URL=
# The audience the provider mints Runtime tokens for. Never derived: a token minted for another API
# in the same tenant must not open this one.
OIDC_AUDIENCE=lorb-runtime
# Most providers sign with RS256. ES256 is kept for the development provider.
OIDC_ALGORITHMS=ES256,RS256
# The claims carrying the platform role and the platform-administrator marker.
OIDC_ROLE_CLAIM=role
OIDC_PLATFORM_ADMIN_CLAIM=platform_admin
ADMIN_ALLOWED_ROLES=admin

# The bundled development identity provider has no password, no consent and no user directory. It is
# refused outright when NODE_ENV is production or staging.
ALLOW_SYNTHETIC_IDENTITY=true

# --------------------------------------------------------------------------- descriptor signing
# The key every replica signs launch descriptors with. Generate one with `pnpm keys:generate`.
# Without this, development generates an ephemeral key at start-up; production refuses to start.
DESCRIPTOR_PRIVATE_KEY_PATH=./keys/descriptor-signing-private.pem
DESCRIPTOR_KID=lorb-descriptor-2026-01-01
# During a rotation, publish both keys at once so descriptors in flight keep verifying:
#   pnpm keys:generate --rotate <current-kid>
# DESCRIPTOR_SIGNING_KEYS=[{"kid":"new","pem":"...","state":"ACTIVE"},{"kid":"old","pem":"...","state":"RETIRING"}]
# Descriptor lifetime in seconds. Bounded to 60–900: a long-lived launch URL is a standing grant.
DESCRIPTOR_TTL_SECONDS=600

# --------------------------------------------------------------------------- LTI 1.3 signing
# Signs the id_token an LTI tool verifies against /api/v1/lti/jwks, and the short-lived login-hint
# token in between — a ring distinct from the descriptor key above because it signs material a third
# party verifies. Optional even in production: a deployment with no LTI tools registered needs none.
# LTI_PRIVATE_KEY_PATH=./keys/lti-signing-private.pem
# LTI_KID=lorb-lti-2026-01-01
# LTI_SIGNING_KEYS=[{"kid":"new","pem":"...","state":"ACTIVE"},{"kid":"old","pem":"...","state":"RETIRING"}]

# The tenant secret the pseudonymisation function is keyed with. Changing it re-pseudonymises every
# learner, so evidence recorded before the change no longer resolves to the same actor.
PSEUDONYM_TENANT_SECRET=<hex-encoded-32-byte-secret>
LORB_TENANT_ID=lorb-default

# --------------------------------------------------------------------------- consumers
# Exact origins, comma-separated. No paths, no trailing slashes, no wildcards — each is refused with
# a message rather than trimmed. In production this list is exactly what you configure here: there
# are no built-in origins.
ALLOWED_CONSUMER_ORIGINS=http://localhost:3300,http://localhost:5173,http://localhost:5176

# --------------------------------------------------------------------------- external embeds
# Origins a packaged "external embed" learning object may point at — an admin cannot register an
# embed_url outside this list. Empty (the default) means the deployment has not opted in to
# external-embed content at all; every registration attempt is refused, in production and out.
# ALLOWED_EXTERNAL_EMBED_ORIGINS=https://trusted-tool.example.com

# --------------------------------------------------------------------------- evidence
# The learning record store the forwarder delivers to. Credentials are required in production.
LRS_ENDPOINT=http://localhost:5000
# LRS_BEARER_TOKEN=
# LRS_BASIC_USERNAME=
# LRS_BASIC_PASSWORD=
LRS_XAPI_VERSION=1.0.3
LRS_TIMEOUT_MS=10000

EVIDENCE_FORWARDER_ENABLED=true
EVIDENCE_FORWARDER_POLL_MS=2000
EVIDENCE_FORWARDER_BATCH=25
# After this many failures a statement is dead-lettered: visible and replayable, never discarded.
EVIDENCE_FORWARDER_MAX_ATTEMPTS=8
EVIDENCE_FORWARDER_BASE_BACKOFF_MS=1000
EVIDENCE_FORWARDER_MAX_BACKOFF_MS=900000

# --------------------------------------------------------------------------- operations
METRICS_ENABLED=true
# On by default in production. Per replica, so raising it raises the total by the replica count.
# RATE_LIMIT_ENABLED=true
RATE_LIMIT_LAUNCHES_PER_MINUTE=120
RATE_LIMIT_SMART_LINKS_PER_MINUTE=60
RATE_LIMIT_EVIDENCE_PER_MINUTE=600
RATE_LIMIT_ADMIN_PER_MINUTE=300
# Read the client address from X-Forwarded-For. On by default in production, where a proxy sets it.
# TRUST_PROXY=true
IDEMPOTENCY_TTL_MS=86400000
MAINTENANCE_INTERVAL_MS=60000
BODY_LIMIT_BYTES=131072

# Publishes the bundled example content. Refused in production: a deployed catalogue contains only
# what was registered through the Publisher API.
SEED_EXAMPLE_CONTENT=true

# Actions that require a second administrator's approval before they take effect.
ADMIN_APPROVAL_REQUIRED_FOR=repository.suspend,repository.retire,player_version.approve,player_version.activate,player_version.suspend,launch_policy_version.publish,launch_policy_version.activate

# --------------------------------------------------------------------------- internal services
# Authenticates the *service* on /api/v1/internal/runtime, never a person: every route behind it
# derives the acting teacher from an explicit agent-principal link. Must differ from the agent
# bearer token below — the Runtime API refuses to start if they match.
RUNTIME_INTERNAL_SERVICE_TOKEN=<hex-encoded-32-byte-service-token>

# --------------------------------------------------------------------------- agent connector
# packages/mcp-connector. Two trust domains that never share a credential:
#   the teacher's agent session, and the service-to-service credential above.
#
# AUTH_MODE=oidc is the default and the only mode a deployed environment may use. shared-token uses
# the pre-shared value below and is refused when NODE_ENV is production or staging.
AUTH_MODE=shared-token
MCP_SHARED_BEARER_TOKEN=<hex-encoded-32-byte-agent-bearer-token>
MCP_CONNECTOR_PORT=4200
RUNTIME_API_BASE=http://localhost:3000
EVIDENCE_API_BASE=http://localhost:3000
ROSTER_API_BASE=http://localhost:3000
# AUTH_MODE=oidc only. The audience should be the connector's own /mcp URL so a client's resource
# check matches; it is never derived, so a token for another API cannot open this one.
# MCP_PUBLIC_URL=https://connector.lorb.example
# OIDC_REQUIRED_SCOPE=

# --------------------------------------------------------------------------- learning record store
# Settings for the bundled learning record store (packages/lrs), where the forwarder delivers to.
# Only this service reads them; the Runtime API reads the LRS_ENDPOINT block above to reach it.
#
# This store's own database. It falls back to DATABASE_URL so local development needs only one, but a
# deployment should give it a separate one: evidence outlives most of what surrounds it, and
# restoring the platform's database must not roll back the record of what a learner did. Required in
# production.
# LRS_DATABASE_URL=postgres://lorb:lorb@localhost:5432/lorb
# The credentials this store accepts. Lists, not single values: rotating the forwarder's token means
# accepting the old and the new one for the length of the rollout. At least one is required in
# production. Generate one with `openssl rand -hex 32`.
# LRS_ACCEPTED_BEARER_TOKENS=<token>[,<token>]
# LRS_ACCEPTED_BASIC_CREDENTIALS=<username>:<password>[,<username>:<password>]
# Refuse a statement whose actor carries an mbox, openid, mbox_sha1sum or display name. On by
# default: LORB's evidence is pseudonymous by construction and this is where that would leak.
# LRS_REQUIRE_PSEUDONYMOUS_ACTOR=true
# LRS_DEFAULT_LIMIT=100
# LRS_MAX_LIMIT=1000
# LRS_PORT=5000

# --------------------------------------------------------------------------- topology
# Which surfaces this process serves besides the API. Both default to false, which is the topology
# a deployment already has: the web applications behind their own static origins, and the agent
# connector as its own service. Setting them folds those surfaces into this process without changing
# what any of them do, so the same image serves either shape and switching is a restart, not a build.
#
# There is deliberately no flag for the Player Shell. It has to stay a separate origin: it serves
# Access-Control-Allow-Origin: * so that modules sandboxed without allow-same-origin can fetch their
# own bundles from an opaque origin, and that header on this origin would mean wildcard CORS on an
# authenticated API.
# SERVE_WEB_APPS=false     # serves /portal/, /admin/ and /console/ from this process
# SERVE_MCP_CONNECTOR=false # mounts the agent connector's /mcp endpoint on this listener
# Where the built bundles are. Unset, the container layout (web/<slug>) is tried and then the
# workspace one (packages/<package>/dist). Set, it is the only place looked at.
# WEB_APPS_ROOT=web

# --------------------------------------------------------------------------- front ends
# Values for the three web applications. None is a credential: an OIDC client id identifies a public
# client, which is what a browser application has to be.
#
# These reach the bundle one of two ways. Built for its own static origin, an application gets them
# at build time through its image's ARG/ENV pair, which is the topology below assumes. Served by the
# API process (SERVE_WEB_APPS above), the same names are read from this process's environment and
# written into the page at request time, so one image runs in any environment without a rebuild.
# Only names carrying the VITE_ prefix are forwarded to a browser, which is the same rule Vite uses.
#
# Two are handled for you in the folded topology and need no value: the API bases default to this
# origin, and VITE_OIDC_REDIRECT_URI is always derived per application from where it is mounted,
# since one shared value would be wrong for two of the three.
# VITE_ENVIRONMENT_LABEL=DEVELOPMENT           # PRODUCTION | STAGING | DEVELOPMENT
# VITE_RUNTIME_API_BASE=http://localhost:3000/api/v1/runtime
# VITE_ADMIN_API_BASE=http://localhost:3000/api/v1/admin
# The Publisher API the Administration workspace authors the catalogue through. Derived from
# VITE_ADMIN_API_BASE where the two surfaces are served together, which they are by default; set it
# only where they are not, or where VITE_ADMIN_API_BASE does not end in /admin.
# VITE_PUBLISHER_API_BASE=http://localhost:3000/api/v1/publisher
# VITE_EVIDENCE_API_BASE=http://localhost:3000/api/v1/evidence
# VITE_JWKS_URL=http://localhost:3000/api/v1/runtime/jwks
# VITE_PLAYER_SHELL_ORIGIN=http://localhost:3200
# VITE_ALLOWED_SHELL_ORIGINS=http://localhost:3200
# VITE_OIDC_ISSUER=
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_REDIRECT_URI=
# VITE_OIDC_AUDIENCE=
# The local sign-in endpoint, reachable only when VITE_ENVIRONMENT_LABEL is DEVELOPMENT.
# VITE_DEVELOPMENT_LOGIN_URL=http://localhost:4000/dev-login
